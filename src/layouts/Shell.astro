---
import '../styles/app.css';
import Row from '../components/Row.astro';
import {
  loadArchive, recent, byCollection, groupByDay, peopleIndex, hrefInList, type Doc,
} from '../lib/archive';
import { slugify } from '../lib/slug';

interface Props {
  title: string;
  description?: string;
  /** Which nav entry is current: a view key, or `person:<slug>`. */
  view?: string;
  listTitle: string;
  items: Doc[];
  /** Highlighted row in the list pane. */
  currentId?: string;
  /**
   * Which pane wins below 760px, where three columns cannot coexist. A document
   * route shows the reader; a listing route shows the list even when it is
   * previewing a document in the reader pane on wider screens.
   */
  mobile?: 'list' | 'reader';
  /** Breadcrumbs in the reader bar. */
  crumbs?: string[];
  /** Listing routes group by day; index-ish routes may not want that. */
  groupDays?: boolean;
  emptyNote?: string;
}

const {
  title, description, view, listTitle, items, currentId, mobile = 'reader',
  crumbs = [], groupDays = true, emptyNote = 'Nothing here yet.',
} = Astro.props;

const all = await loadArchive();
const feed = recent(all);

const views = [
  { key: 'latest',      label: 'Latest',      href: '/',            count: feed.length },
  { key: 'briefs',      label: 'Briefs',      href: '/briefs',      count: byCollection(all, 'briefs').length },
  { key: 'longform',    label: 'Long-form',   href: '/longform',    count: byCollection(all, 'longform').length },
  { key: 'discussions', label: 'Discussions', href: '/discussions', count: byCollection(all, 'discussions').length },
  { key: 'news',        label: 'News',        href: '/news',        count: byCollection(all, 'news').length },
  { key: 'companies',   label: 'Companies',   href: '/companies',   count: byCollection(all, 'companies').length },
  { key: 'reviews',     label: 'Reviews',     href: '/reviews',     count: byCollection(all, 'reviews').length },
  { key: 'archive',     label: 'Archive',     href: '/archive',     count: all.length },
];

// The design's nav carries a "Tags" tree. There is no tag field in the schema,
// so the tree is people — one of the three axes retrieval actually runs on, and
// populated as a byproduct of writing a document rather than curated. Capped:
// the nav is for the names that recur, and /people has the rest.
const NAV_PEOPLE = 12;
const peopleNav = [...peopleIndex(all)]
  .map(([slug, { name, docs }]) => ({
    key: `person:${slug}`,
    label: name,
    href: `/people/${slug}`,
    count: docs.length,
  }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label))
  .slice(0, NAV_PEOPLE);

const days = groupDays ? groupByDay(items) : [];
const listMeta = `${items.length} ${items.length === 1 ? 'item' : 'items'}`;
const rootClass = mobile === 'reader' ? 'pane-reader' : 'pane-list';
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Below 760px the list pane is hidden on a document route, so the reader needs a
// way back to it. One segment up is that listing for every route on the site.
let upHref = Astro.url.pathname.replace(/\/[^/]*\/?$/, '') || '/';
if (upHref === '/latest') upHref = '/';


// A listing named after its own document type would otherwise render
// "Long-form / Long-form".
const trail = crumbs.filter((c, i) => i === 0 || c !== crumbs[i - 1]);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonical} />
  <link rel="alternate" type="application/rss+xml" title="The Open/Close — briefs" href="/feed.xml" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&display=swap"
  />
  <link
    rel="icon"
    href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23201e1d'/%3E%3Crect x='7' y='7' width='18' height='18' fill='%23ec3013'/%3E%3C/svg%3E"
  />
</head>
<body>
<div class={`shell ${rootClass}`}>

  <!-- COLUMN 1 — NAV -->
  <nav class="pane nav-pane" aria-label="Views">
    <div class="bar">
      <a class="mark" href="/">
        <span class="tick"></span>
        <span class="wordmark">OPEN/CLOSE</span>
      </a>
    </div>

    <div class="nav-body">
      <div class="nav-head">Views</div>
      <div class="nav-group">
        {views.map((v) => (
          <a class="nav-item" href={v.href} aria-current={view === v.key ? 'page' : undefined}>
            <span>{v.label}</span>
            <span class="count">{v.count}</span>
          </a>
        ))}
      </div>

      <div class="nav-rule"></div>

      <div class="nav-head">People</div>
      <div class="nav-sub">
        {peopleNav.map((t) => (
          <a class="nav-item" href={t.href} aria-current={view === t.key ? 'page' : undefined}>
            <span>{t.label}</span>
            <span class="count">{t.count}</span>
          </a>
        ))}
        {peopleNav.length === 0 && <div class="empty">No people named yet.</div>}
        {peopleNav.length === NAV_PEOPLE && (
          <a class="nav-item" href="/people" aria-current={view === 'people' ? 'page' : undefined}>
            <span>All people →</span>
          </a>
        )}
      </div>
    </div>

    <div class="nav-foot">
      <span>Search</span>
      <a href="/search">FIND</a>
    </div>
  </nav>

  <!-- COLUMN 2 — LIST -->
  <div class="pane list-pane">
    <div class="bar">
      <span class="bar-title">{listTitle}</span>
      <span class="bar-meta">{listMeta}</span>
    </div>

    <div class="compact-nav">
      <div class="compact-row">
        {views.map((v) => (
          <a class="compact-chip" href={v.href} aria-current={view === v.key ? 'page' : undefined}>{v.label}</a>
        ))}
      </div>
      <div class="compact-row">
        <a class="compact-chip" href="/people" aria-current={view === 'people' ? 'page' : undefined}>People</a>
        <a class="compact-chip" href="/search">Search</a>
      </div>
    </div>

    <div class="list-body">
      {groupDays
        ? days.map((day) => (
            <div>
              <div class="day-head">{day.label}</div>
              {day.items.map((doc) => <Row doc={doc} current={doc.id === currentId} href={hrefInList(doc, view)} />)}
            </div>
          ))
        : items.map((doc) => <Row doc={doc} current={doc.id === currentId} showDate href={hrefInList(doc, view)} />)}
      {items.length === 0 && <div class="empty">{emptyNote}</div>}
    </div>
  </div>

  <!-- COLUMN 3 — READER -->
  <main class="pane reader-pane">
    <div class="bar">
      <a class="back-ctl" href={upHref}>&#8249; All posts</a>
      {trail.map((c, i) => (
        <Fragment>
          {i > 0 && <span class="crumb-sep">/</span>}
          <span class={i === trail.length - 1 ? 'crumb-now' : 'crumb'}>{c}</span>
        </Fragment>
      ))}
      <a class="bar-act" href="/archive">ARCHIVE</a>
    </div>
    <slot />
  </main>

</div>
</body>
</html>
