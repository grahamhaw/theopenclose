---
import Shell from '../../layouts/Shell.astro';
import Document from '../../components/Document.astro';
import Placeholder from '../../components/Placeholder.astro';
import { loadArchive, byCollection } from '../../lib/archive';

const items = byCollection(await loadArchive(), 'news');
const lead = items[0];
---
<Shell
  title="News — The Open/Close"
  view="news"
  listTitle="News"
  items={items}
  currentId={lead?.id}
  mobile="list"
  crumbs={['News', lead ? lead.kind : 'Empty']}
  emptyNote="No news documents yet. Most news does not earn one."
>
  {lead
    ? <Document doc={lead} />
    : <Placeholder head="No News yet" note="No news documents yet. Most news does not earn one." />}
</Shell>
