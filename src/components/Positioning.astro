---
import type { Routing } from '../lib/positioning';

/**
 * The positioning read, rendered as the design's delta chips.
 *
 * Only the theme and the direction — the reasoning stays in the document body,
 * where the agent wrote it. This strip exists to make the routing glanceable and
 * clickable, not to restate the prose.
 */
interface Props { routings: Routing[]; }
const { routings } = Astro.props;

const CHIP: Record<string, { cls: string; label: string }> = {
  STRENGTHENS: { cls: 'delta-strengthens', label: '▲ Strengthens' },
  WEAKENS:     { cls: 'delta-weakens',     label: '▼ Weakens' },
  NEUTRAL:     { cls: 'delta-neutral',     label: '▸ Neutral' },
};

// One document can route to a theme once. Keep the first if it does not.
const seen = new Set<string>();
const rows = routings.filter((r) => {
  if (seen.has(r.themeId)) return false;
  seen.add(r.themeId);
  return true;
});
---
{rows.length > 0 && (
  <section class="sec" data-pagefind-ignore>
    <div class="sec-rule"></div>
    <div class="sec-head">
      <span class="h">Positioning</span>
      <span class="n">{`${rows.length} ${rows.length === 1 ? 'theme' : 'themes'}`}</span>
    </div>
    {rows.map((r) => (
      <div class="delta">
        <span class={`delta-chip ${CHIP[r.direction].cls}`}>{CHIP[r.direction].label}</span>
        <div style="min-width:0">
          <div class="delta-name"><a href={`/themes/${r.themeId}`}>{r.themeId}</a></div>
        </div>
      </div>
    ))}
  </section>
)}
